FROM node:24-alpine AS build

WORKDIR /app

ARG VITE_CUSTOMER_ID=customer-001
ARG VITE_BUCKET_API_URL=http://localhost:8001
ARG VITE_CONTRIBUTION_API_URL=http://localhost:8002
ARG VITE_WITHDRAWAL_API_URL=http://localhost:8003
ARG VITE_RECURRING_API_URL=http://localhost:8004
ARG VITE_NOTIFICATION_API_URL=http://localhost:8005
ENV VITE_CUSTOMER_ID=${VITE_CUSTOMER_ID}
ENV VITE_BUCKET_API_URL=${VITE_BUCKET_API_URL}
ENV VITE_CONTRIBUTION_API_URL=${VITE_CONTRIBUTION_API_URL}
ENV VITE_WITHDRAWAL_API_URL=${VITE_WITHDRAWAL_API_URL}
ENV VITE_RECURRING_API_URL=${VITE_RECURRING_API_URL}
ENV VITE_NOTIFICATION_API_URL=${VITE_NOTIFICATION_API_URL}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
